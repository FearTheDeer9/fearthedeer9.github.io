---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Article from '../../components/Article.astro';
import { notes, type Note } from '../../lib/site';

// Evergreen notes come from two places: the original site notes and evergreen notes imported from the vault.
export async function getStaticPaths() {
  const imported = (await getCollection('entries')).filter((e) => e.data.type === 'evergreen');
  return [
    ...(await notes()).map((note) => ({ params: { slug: note.id }, props: { note } })),
    ...imported.map((note) => ({ params: { slug: note.id.split('/').pop() }, props: { note } })),
  ];
}
const { note } = Astro.props as { note: Note };
const { Content } = await render(note);
// Backlinks: every note whose body links here.
const backlinks = (await getCollection('notes')).filter((n) => n.id !== note.id && n.body?.includes(`](${note.id}.md`));
---
<Base title={note.data.title}>
  <Article title={note.data.title} type="evergreen">
    <Content />
  </Article>
  {backlinks.length > 0 && (
    <section class="block">
      <h2 class="label">Linked from</h2>
      <ul class="list">{backlinks.map((n) => <li><a href={`/notes/${n.id}/`}>{n.data.title}</a></li>)}</ul>
    </section>
  )}
</Base>
