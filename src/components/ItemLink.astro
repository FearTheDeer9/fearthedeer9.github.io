---
// A published item links to its page; a logged-only item is plain text, marked as logged.
import type { Item } from '../lib/manifest';
interface Props { i: Item; text?: string }
const { i, text = i.title } = Astro.props;
---
{i.url ? <a href={i.url}>{text}</a> : <span class="logged" title="Logged, not published">{text}</span>}
